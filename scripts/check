#!/bin/sh
# Kör testerna eller lint med en Python som har testberoendena installerade.
# Ordning: ./.venv, $HA_BUSSAR_VENV (standard ~/.venvs/ha-bussar), python3, python.
# Används av .no-mistakes.yaml och CI, så att samma kommando fungerar överallt.
set -eu

find_python() {
  for candidate in ./.venv/bin/python "${HA_BUSSAR_VENV:-$HOME/.venvs/ha-bussar}/bin/python"; do
    if [ -x "$candidate" ]; then
      echo "$candidate"
      return
    fi
  done
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
      echo "$candidate"
      return
    fi
  done
  echo "Hittar ingen Python. Skapa .venv: python3 -m venv .venv && .venv/bin/pip install -r requirements_test.txt" >&2
  exit 1
}

PY=$(find_python)

case "${1:-}" in
  test)
    "$PY" -m pytest -q -p no:cacheprovider
    exec node --test tests/js/*.test.mjs
    ;;
  lint)
    "$PY" -m ruff check custom_components tests scripts
    exec "$PY" -m mypy custom_components/bussar --ignore-missing-imports
    ;;
  *)
    echo "Användning: scripts/check test|lint" >&2
    exit 2
    ;;
esac
